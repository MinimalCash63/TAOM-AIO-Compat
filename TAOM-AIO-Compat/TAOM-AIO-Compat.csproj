<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TAOM-AIO-Compat</AssemblyName>
    <RootNamespace>TAOM_AIO_Compat</RootNamespace>
    <Version>1.5.8</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameBin>$(GameFolder)\bin\Win64_Shipping_Client</GameBin>
    <DepsBin>$(GameFolder)\Modules\TAOM.Dependencies\bin\Win64_Shipping_Client</DepsBin>
    <ModuleOut Condition="'$(ModuleOut)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\output\AIO-Compat-Patch\TAOM-AIO-Compat\</ModuleOut>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ModuleManager"><HintPath>$(GameBin)\TaleWorlds.ModuleManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(GameBin)\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(GameBin)\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data"><HintPath>$(GameBin)\TaleWorlds.GauntletUI.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.TwoDimension"><HintPath>$(GameBin)\TaleWorlds.TwoDimension.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(GameBin)\TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(GameBin)\TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
    <!-- Harmony 2.4.2 and MCM v5 5.12.3 come from TAOM.Dependencies at run time; never ship them. -->
    <Reference Include="0Harmony"><HintPath>$(DepsBin)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MCMv5"><HintPath>$(DepsBin)\MCMv5.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- RBM switch: balance tables from Theb0yys' RBM-TAOM-2.0.29.5 (permission logged 13 Nov 2026), embedded by file name. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixes\RBM\Resources\**\*" LogicalName="TAOM_AIO_Compat.RBM.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Lay out the finished module (SubModule.xml, GUI, bin) in output, never in the game folder. -->
  <Target Name="LayOutModule" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Module\SubModule.xml" DestinationFolder="$(ModuleOut)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Module\README.txt" DestinationFolder="$(ModuleOut)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Module\GUI\Brushes\TAOM_AIO_Compat.xml" DestinationFolder="$(ModuleOut)GUI\Brushes\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleOut)bin\Win64_Shipping_Client\" />
    <!-- Dual Wield switch: corrected TAOM troops file from Dual Wield - TAOM (permission logged 13 Nov 2026). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Module\ModuleData\aio_dualwield_troops.xml;$(MSBuildProjectDirectory)\Module\ModuleData\aio_dualwield_troops.xslt" DestinationFolder="$(ModuleOut)ModuleData\" />
  </Target>
</Project>
